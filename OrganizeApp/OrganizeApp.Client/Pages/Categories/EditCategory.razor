
@page "/categories/edit/{id:int}"
@rendermode _renderMode

<HeadContent>
    <PageTitle>Edycja kategorii</PageTitle>
</HeadContent>

<Auth>
    <ChildContent Context="AuthContext">
        @if (_isPageLoading)
        {
            <Loading />
        }
        else
        {
            <h2>Edycja kategorii</h2>

            <button class="btn btn-secondary mt-3" @onclick="ReturnToMyCategories"> Powrót</button>

            <div class="my-4 col-6">

                <EditForm Model="_category" OnValidSubmit="() => Edit(AuthContext)" FormName="EditCategory">

                    <DataAnnotationsValidator />

                    <div class="my-3">
                        <label class="form-label">Nazwa</label>
                        <InputText @bind-Value="_category.Name" class="form-control" />
                        <ValidationMessage For="() => _category.Name" />
                    </div>

                    <div class="my-3">
                        <label class="form-label d-block">Kolor</label>
                        <RadzenColorPicker @bind-Value=@_category.Color ShowHSV=false ShowRGBA=false ShowColors=true ShowButton=false >
                            <RadzenColorPickerItem Value="rgba(255, 40, 0, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(254, 147, 0, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(254, 251, 0, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(2, 249, 0, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(0, 253, 255, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(4, 51, 255, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(255, 64, 255, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(148, 34, 146, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(170, 121, 66, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(255, 255, 255, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(0, 0, 0, 0.6)" />
                            <RadzenColorPickerItem Value="rgba(83, 213, 253, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(115, 167, 254, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(135, 78, 254, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(211, 87, 254, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(237, 113, 158, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(255, 140, 130, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(255, 165, 125, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(255, 198, 119, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(255, 249, 149, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(235, 243, 143, 0.9)" />
                            <RadzenColorPickerItem Value="rgba(177, 221, 140, 0.9)" />
                        </RadzenColorPicker>
                    </div>

                    <div class="my-3">
                        @if (_isLoading)
                        {
                            <button class="btn btn-primary btn-lg btn-spinner" type="submit" disabled>
                                <img src="/loading.gif" />
                                <span>Zapisywanie...</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-lg" type="submit">Zapisz</button>
                        }
                    </div>

                </EditForm>
            </div>
        }
    </ChildContent>
</Auth>