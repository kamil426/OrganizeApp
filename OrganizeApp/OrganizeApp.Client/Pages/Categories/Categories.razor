@page "/categories"
@rendermode _rendermode

<HeadContent>
    <PageTitle>Moje Kategorie</PageTitle>
</HeadContent>

<Auth>
    <ChildContent Context="AuthContext">
        @if (_isLoading)
        {
            <Loading />
        }
        else if (_categoriesList is null)
        {
            <h5 class="col-12 my-5 text-center fw-bold">Brak danych!</h5>
        }
        else
        {
            <h2>Moje Kategorie</h2>

            @* Modal delete categories *@
            <Modal @ref="_modalDeleteCategories" Title="Usuwanie kategorii"
                   IconStyleId="Modal.IconStyle.Warning"
                   HeaderColor="#4340D2"
                   ButtonStyleId="Modal.ButtonStyle.YesNo"
                   OnClickButtonYes="() => DeleteCategories(AuthContext)"
                   OnClickButtonNo="CancelDelete"
                   IsXCloseButtonVisible="false">
                <Content>
                    Czy na pewno chcesz usunąć zaznaczone kategorie?
                </Content>
            </Modal>

            @* Buttons *@
            @if (_categoriesList.Any())
            {
                <div class="mt-3 btn-row">
                    <button class="btn btn-success me-1" @onclick="AddCategory">
                        Dodaj kategorię
                    </button>

                    <button class="btn @(_isDeleteTrybeEnabled ? "btn-danger" : "btn-secondary") btn-delete-categories me-1" @onclick="Delete">
                        <span class="fa-regular--trash-alt me-1" />
                        <span>@(_isDeleteTrybeEnabled ? "Usuń" : "Usuwanie")</span>
                    </button>

                    <button class="btn btn-secondary @(_isDeleteTrybeEnabled ? "" : "hide-element")" @onclick="CancelDeleteTrybe">Anuluj</button>
                </div>
            }

            @* Categories *@
            @if (_categoriesList.Any())
            {
                <div class="col-7 mt-4">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th class="text-center align-middle w-15 @(_isDeleteTrybeEnabled ? "" : "hide-element")">Usuwanie</th>
                                <th class="text-center align-middle">Nazwa kategorii</th>
                                <th class="text-center align-middle w-15">Kolor Kategorii</th>
                                <th class="text-center align-middle w-15">Edycja</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in _categoriesList)
                            {
                                <tr>
                                    <td class="text-center align-middle @(_isDeleteTrybeEnabled ? "" : "hide-element")">
                                        <input type="checkbox" class="delete-checkbox form-check-input border-black @(_isDeleteTrybeEnabled ? "" : "hide-element")" @onchange="(e) => AddCategoriesToListDeletingItems(category.Id, e)" />
                                    </td>
                                    <td class="align-middle">@category.Name</td>
                                    <td class="align-middle text-center inset-shadow" style="background-color:@category.Color;"></td>
                                    <td class="d-flex justify-content-center">
                                        <button class="btn btn-info" @onclick="() => EditCategory(category.Id)">Edytuj</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>

            }
            else
            {
                <h5 class="col-12 my-5 text-center fw-bold">Brak kategorii!</h5>
            }
        }
    </ChildContent>
</Auth>
