@page "/categories/add"
@rendermode _renderMode

<HeadContent>
    <PageTitle>Dodawanie kategorii</PageTitle>
</HeadContent>

<Auth>
    <ChildContent Context="AuthContext">
        @if (_isPageLoading)
        {
            <Loading />
        }
        else
        {
            <h2>Dodaj kategorię</h2>

            <button class="btn btn-secondary mt-3" @onclick="Return"> Powrót</button>

            <div class="my-4 col-6">

                <EditForm Model="_category" OnValidSubmit="() => Add(AuthContext)" FormName="AddCategory">

                    <DataAnnotationsValidator />

                    <div class="my-3">
                        <label class="form-label">Nazwa</label>
                        <InputText @bind-Value="_category.Name" class="form-control" />
                        <ValidationMessage For="() => _category.Name" />
                    </div>

                    <div class="my-3">
                        <label class="form-label d-block">Kolor</label>
                        <RadzenColorPicker @bind-Value=@_category.Color ShowHSV=false ShowRGBA=false ShowColors=true ShowButton=false />
                    </div>

                    <div class="my-3">
                        @if (_isLoading)
                        {
                            <button class="btn btn-primary btn-lg btn-spinner" type="submit" disabled>
                                <img src="/loading.gif" />
                                <span>Zapisywanie...</span>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-lg" type="submit">Zapisz</button>
                        }
                    </div>

                </EditForm>
            </div>
        }
    </ChildContent>
</Auth>