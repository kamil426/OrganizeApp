@using TaskStatus = OrganizeApp.Shared.Common.Enums.TaskStatus;

@rendermode _renderMode
@page "/tasks"

<HeadContent>
    <PageTitle>Moje zadania</PageTitle>
</HeadContent>

<Auth>
    <ChildContent Context="AuthContext">

        @if (_isLoading)
        {
            <Loading />
        }
        else if (_tasksList is null)
        {
            <h5 class="col-12 my-5 text-center fw-bold">Brak danych!</h5>
        }
        else
        {
            <h2>Moje zadania</h2>

            @* Modal delete tasks *@
            <Modal @ref="_modalDeleteTasks" Title="Usuwanie zadań"
                   IconStyleId="Modal.IconStyle.Warning"
                   HeaderColor="#4340D2"
                   ButtonStyleId="Modal.ButtonStyle.YesNo"
                   OnClickButtonYes="() => DeleteTasks(AuthContext)"
                   OnClickButtonNo="CancelDelete"
                   IsXCloseButtonVisible="false">
                <Content>
                    Czy na pewno chcesz usunąć zaznaczone zadania?
                </Content>
            </Modal>

            @* Modal checkList configuration *@
            <Modal @ref="_modalCheckListConfiguration" Title="Konfiguracja check listy"
                   IconStyleId="Modal.IconStyle.None"
                   HeaderColor="#4340D2"
                   ButtonStyleId="Modal.ButtonStyle.OkCancel"
                   OnClickButtonOk="ConfigCheckList"
                   IsXCloseButtonVisible="false">
                <Content>
                    <h5>Wybierz kategorię zadań, które chcesz aby się znalazły na liście</h5>
                    <ul class="checklist-option mt-4">
                        <li class="m-2">
                            <input type="checkbox" checked="@_checkListConfiguration.ElementAt(Convert.ToInt32(TaskStatus.ToDo) - 1).IsChecked" class="form-check-input" @onchange="(e) => ConfigCheckListChanged(TaskStatus.ToDo, e)" />
                            <label class="form-label ms-1">Do zrobienia</label>
                        </li>
                        <li class="m-2">
                            <input type="checkbox" checked="@_checkListConfiguration.ElementAt(Convert.ToInt32(TaskStatus.InProgress) - 1).IsChecked" class="form-check-input" @onchange="(e) => ConfigCheckListChanged(TaskStatus.InProgress, e)" />
                            <label class="form-label ms-1">W trakcie</label>
                        </li>
                        <li class="m-2">
                            <input type="checkbox" checked="@_checkListConfiguration.ElementAt(Convert.ToInt32(TaskStatus.Complete) - 1).IsChecked" class="form-check-input" @onchange="(e) => ConfigCheckListChanged(TaskStatus.Complete, e)" />
                            <label class="form-label ms-1">Zakończone</label>
                        </li>
                    </ul>
                    @if (!_isCheckListConfigValid)
                    {
                        <p class="fw-light text-danger mb-0">Proszę zaznaczyć którąkolwiek z opcji, aby wygenerować check listę!</p>
                    }
                </Content>
            </Modal>

            @* Buttons *@
            @if (_tasksList.Any())
            {
                <div class="mt-3 btn-row">
                    <button class="btn btn-primary me-1" disabled="@(!_tasksList.Any())" @onclick="GenerateCheckList">
                        Generuj check listę
                    </button>

                    <button class="btn @(_isDeleteTrybeEnabled ? "btn-danger" : "btn-secondary") btn-delete-tasks me-1" @onclick="Delete">
                        <span class="fa-regular--trash-alt me-1" />
                        <span>@(_isDeleteTrybeEnabled ? "Usuń" : "Usuwanie")</span>
                    </button>

                    <button class="btn btn-secondary @(_isDeleteTrybeEnabled ? "" : "hide-element")" @onclick="CancelDeleteTrybe">Anuluj</button>
                </div>
            }

            @* Canban table *@
            <div class="canban-table mt-4">

                @foreach (var item in Enum.GetValues<OrganizeApp.Shared.Common.Enums.TaskStatus>())
                {
                    if (Convert.ToInt32(item) != 0)
                    {
                        @* Column *@
                        <div class="canban-column p-2 rounded @(TaskStatus.InProgress.Equals(item) ? "ms-2 me-2" : "")" data-id="@Convert.ToInt32(item)">

                            @* Column header *@
                            <p class="canban-header">
                                <b class="me-2">@item.AsString(EnumFormat.DisplayName)</b>
                                <span class="ri--todo-line"></span>
                            </p>

                            @if (_tasksList.Any() && (_tasksList.FirstOrDefault(x => x.TaskStatus == item) is not null))
                            {
                                <div class="draggable-tasks">
                                    @foreach (var task in _tasksList)
                                    {
                                        @if (task.TaskStatus == item)
                                        {
                                            @* Task drag and drop *@
                                            <div @onmouseenter="() => OnMouseEnter(task.Id)" class="border-1 rounded my-1 p-1 font-small @(_isDeleteTrybeEnabled ? "draggable-task-disabled" : "draggable-task")" data-id="@task.Id">

                                                @* Task Header and Footer *@
                                                <section>

                                                    @* Task Header *@
                                                    <div class="task-header">
                                                        <h6 class="text-start col-11 mb-1 fw-bold">
                                                            @task.Title
                                                        </h6>
                                                        <span class="nimbus--edit col-1 @(_isDeleteTrybeEnabled ? "hide-element" : "")" @onclick="() => EditTask(task.Id)"></span>
                                                        <input type="checkbox" class="delete-checkbox form-check-input border-black @(_isDeleteTrybeEnabled ? "" : "hide-element")" @onchange="(e) => AddTaskToListDeletingItems(task.Id, e)" />
                                                    </div>

                                                    @* Task Footer *@
                                                    <div class="task-footer">

                                                        @* Link Open description *@
                                                        <div>
                                                            <a class="task-footer__link @(_isDeleteTrybeEnabled ? "disabled-link" : "")" @onclick="() => OpenDescription(task.Id)">Czytaj opis...</a>
                                                        </div>

                                                        @* Date *@
                                                        @switch (Convert.ToInt32(item))
                                                        {
                                                            case 1:
                                                                @if (task.DateOfPlannedStart is not null)
                                                                {
                                                                    <div>Rozpoczęcie: @task.DateOfPlannedStart.Value.ToString("dd-MM-yyyy HH:mm")</div>
                                                                }
                                                                break;
                                                            case 2:
                                                                @if (task.DateOfPlannedEnd is not null)
                                                                {
                                                                    <div>Zakończenie: @task.DateOfPlannedEnd.Value.ToString("dd-MM-yyyy HH:mm")</div>
                                                                }
                                                                break;
                                                            case 3:
                                                                @if (task.DateOfComplete is not null)
                                                                {
                                                                    <div>Zakończono: @task.DateOfComplete.Value.ToString("dd-MM-yyyy HH:mm")</div>
                                                                }
                                                                break;
                                                        }
                                                    </div>
                                                </section>

                                                @* Category *@
                                                @if (task.CategoryId is not null)
                                                {
                                                    <section class="task-category mt-1 text-center" style="background-color: @task.CategoryDto.Color;">
                                                        <span class="task-category__text">
                                                            @task.CategoryDto.Name
                                                        </span>
                                                    </section>
                                                }
                                            </div>
                                        }
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="text-center my-4 fw-bold">Brak zadań!</div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </ChildContent>
</Auth>